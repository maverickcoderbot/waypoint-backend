# Copy to .env (git-ignored) and source it, or export these in your shell.

# PostGIS-capable Postgres — see README for a Docker one-liner.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/waypoint
DATABASE_USER=waypoint
DATABASE_PASSWORD=waypoint

# Comma-separated origins allowed to call /api/** (browser CORS).
WAYPOINT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://maverickcoderbot.github.io
